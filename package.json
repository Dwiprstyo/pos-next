{
  "name": "pos-kds",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "db:start": "supabase start -x studio,postgres-meta,logflare,vector,edge-runtime,imgproxy",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset && ./scripts/db-setup.sh",
    "db:setup": "./scripts/db-setup.sh",
    "db:types": "supabase gen types typescript --local > src/lib/database.types.ts",
    "typecheck": "tsc --noEmit",
    "db:patch-images": "./scripts/patch-supabase-images.sh",
    "test:smoke": "node scripts/smoke-test.mjs",
    "test:e2e": "node scripts/e2e-test.mjs",
    "test:realtime": "node scripts/realtime-test.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@node-rs/argon2": "^2.2.1",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.116.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.3.2",
    "dexie": "^4.4.6",
    "lucide-react": "^1.47.0",
    "next": "15.5.25",
    "next-themes": "^0.4.6",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "shadcn": "^4.21.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.5",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "15.5.25",
    "playwright": "^1.63.0",
    "supabase": "^2.117.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
