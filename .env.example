# Hosted Supabase: replace the three values below.
# NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon-or-publishable-key>
# SUPABASE_SERVICE_ROLE_KEY=<service-role-or-secret-key>

# ── Payment gateway (opsional) ──────────────────────────────
# Tanpa MIDTRANS_SERVER_KEY, hanya pembayaran tunai yang aktif.
# MIDTRANS_SERVER_KEY=SB-Mid-server-xxxxxxxxxxxx
# MIDTRANS_CLIENT_KEY=SB-Mid-client-xxxxxxxxxxxx
# MIDTRANS_IS_PRODUCTION=false
#
# Secret untuk webhook generik /api/payments/webhook (provider selain Midtrans).
# PAYMENT_GATEWAY_WEBHOOK_SECRET=

